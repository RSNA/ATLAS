{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://atlas.rsna.org/schemas/2026-12/dataset.json",
	"title": "ATLAS dataset schema",
	"description": "RSNA ATLAS dataset schema, 2026-12 version",
	"$comment": "Copyright (c) 2026, Radiological Society of North America",
	"type": "object",
	"minProperties": 1,
	"properties": {
		"$schema": {
			"description": "The JSON Schema version identifier for this document.",
			"type": "string",
			"const": "https://atlas.rsna.org/schemas/2026-12/dataset.json"
		},
		"Dataset": {
			"description": "Describes an AI dataset",
			"$ref": "#/$defs/Dataset"
		}
	},
	"required": [
		"$schema",
		"Dataset"
	],
	"additionalProperties": false,
	"$defs": {
		"Dataset": {
			"description": "Describes an AI dataset",
			"$comment": "ROADMAP:00003",
			"type": "object",
			"minProperties": 1,
			"properties": {
				"Name": {
					"description": "Dataset name (required)",
					"$comment": "ROADMAP:03597",
					"type": "string",
					"minLength": 4,
					"maxLength": 256,
					"examples": [
						"Radiological Society of North America Abdominal Traumatic Injury CT (RATIC) Dataset"
					]
				},
				"Summary": {
					"description": "Textual summary of the dataset",
					"type": "string",
					"minLength": 1,
					"maxLength": 2500
				},
				"Link": {
					"description": "URL pointer to source (required)",
					"type": "string",
					"minLength": 4,
					"maxLength": 256,
					"format": "uri",
					"examples": [
						"https://doi.org/10.1148/dataset.ratic.2024"
					]
				},
				"Indexing": {
					"description": "Indexing information, such as content codes, RadLex + SNOMED codes, and keywords.",
					"$ref": "#/$defs/Indexing"
				},
				"General metadata": {
					"description": "Details of the dataset",
					"$ref": "#/$defs/General-metadata"
				},
				"Dataset properties": {
					"description": "Properties specific to datasets",
					"$ref": "#/$defs/Dataset-properties"
				},
				"Imaging": {
					"description": "Information about the imaging data",
					"$ref": "#/$defs/Imaging"
				},
				"Partitions": {
					"description": "Dataset partitions (training, validation, testing, etc.) with aggregate statistics and optional demographic/clinical breakdowns",
					"$ref": "#/$defs/Partitions"
				},
				"Models": {
					"description": "Models known to use this dataset, disaggregated by role (e.g. training, validation, test).",
					"$comment": "ROADMAP:04234",
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "object",
						"minProperties": 1,
						"properties": {
							"Model": {
								"description": "Pointer to or description of the model.",
								"type": "object",
								"minProperties": 1,
								"maxProperties": 2,
								"properties": {
									"URI": {
										"description": "Pointer to the model, e.g. a model card conforming to the ATLAS model schema (preferred)",
										"type": "string",
										"minLength": 1,
										"maxLength": 256,
										"format": "uri"
									},
									"Description": {
										"description": "Textual description of the model",
										"type": "string",
										"minLength": 1,
										"maxLength": 512
									}
								},
								"additionalProperties": false
							},
							"Role": {
								"description": "This dataset's role in the model's development.",
								"$comment": "ROADMAP:03763",
								"type": "string",
								"enum": [
									"Training",
									"Optimization",
									"Testing",
									"External testing",
									"Pretraining",
									"Fine-tuning"
								]
							}
						},
						"required": [
							"Model",
							"Role"
						],
						"additionalProperties": false
					}
				}
			},
			"required": [
				"Name",
				"Link"
			],
			"additionalProperties": false
		},
		"Dataset-properties": {
			"description": "Attributes of the dataset",
			"$comment": "ROADMAP:03381",
			"type": "object",
			"minProperties": 1,
			"properties": {
				"Confidentiality": {
					"description": "Describes any data that might be confidential, such as those protected by law or doctor-patient confidentiality.",
					"$comment": "ROADMAP:03413",
					"type": "string",
					"minLength": 1,
					"maxLength": 1000
				},
				"External data": {
					"description": "External resources such as web sites, social-media posts or other datasets. Include information about their permanence, archival versions, and any restrictions on their use (e.g., data-use agreements, licenses, fees),",
					"$comment": "ROADMAP:03412",
					"type": "string",
					"minLength": 1,
					"maxLength": 1000
				},
				"Missing information": {
					"description": "Describes what information, if any, is missing from the dataset and why.",
					"$comment": "ROADMAP:03408",
					"type": "string",
					"minLength": 1,
					"maxLength": 1000
				},
				"Motivation": {
					"description": "Describes the specific purpose for which the dataset was created. May include information about funding sources.",
					"$comment": "ROADMAP:03383",
					"type": "string",
					"minLength": 1,
					"maxLength": 1000
				},
				"Noise": {
					"description": "Describes any errors, sources of noise, or redundancies in the dataset.",
					"$comment": "ROADMAP:03411",
					"type": "string",
					"minLength": 1,
					"maxLength": 1000
				},
				"Partitioning scheme": {
					"description": "Describes how a dataset was partitioned for training, optimization (\"validation\") and testing.",
					"$comment": "ROADMAP:03410",
					"type": "string",
					"minLength": 1,
					"maxLength": 1000
				},
				"Re-identification": {
					"description": "Describes if and how it is possible to identify individual persons, either directly or indirectly, from the dataset.",
					"$comment": "ROADMAP:03415",
					"type": "string",
					"minLength": 1,
					"maxLength": 1000
				},
				"Relationships between instances": {
					"description": "Describes if and how any relationships between individual data items are made explicit.",
					"$comment": "ROADMAP:03409",
					"type": "string",
					"minLength": 1,
					"maxLength": 1000
				},
				"Sampling": {
					"description": "Describes how the data that form the dataset were selected.",
					"$comment": "ROADMAP:03396",
					"type": "string",
					"minLength": 1,
					"maxLength": 1000
				},
				"Sensitive data": {
					"description": "Describes any data that might be considered sensitive.",
					"$comment": "ROADMAP:03416",
					"type": "string",
					"minLength": 1,
					"maxLength": 1000
				}
			},
			"additionalProperties": false
		},
		"Date": {
			"description": "Date (Year or ISO-format date)",
			"$comment": "ROADMAP:00065",
			"examples": [
				"2025-01-01",
				2025
			],
			"oneOf": [
				{
					"type": "string",
					"minLength": 1,
					"maxLength": 10,
					"format": "date"
				},
				{
					"type": "integer",
					"minimum": 1900,
					"maximum": 2100
				}
			]
		},
		"General-metadata": {
			"description": "Characteristics of a project, model, or dataset.  Whenever possible, values should link to other ontologies or controlled vocabularies.",
			"$comment": "ROADMAP:00004",
			"type": "object",
			"minProperties": 1,
			"properties": {
				"Authors": {
					"description": "Authors",
					"$comment": "ROADMAP:00064",
					"type": "array",
					"minItems": 1,
					"items": {
						"$ref": "#/$defs/Person"
					}
				},
				"Comments": {
					"description": "Textual comments about the model, dataset, or project.",
					"$comment": "ROADMAP:00070",
					"type": "string",
					"minLength": 2,
					"maxLength": 512
				},
				"Contact": {
					"description": "Physical address or email address of a contact.",
					"$comment": "ROADMAP:00069",
					"type": "string",
					"minLength": 2,
					"maxLength": 512
				},
				"Date": {
					"description": "Dates associated with this resource, such as creation, publication, or update dates.",
					"$comment": "ROADMAP:00065",
					"type": "object",
					"minProperties": 1,
					"properties": {
						"Created": {
							"description": "Creation date (ROADMAP:03419)",
							"$comment": "ROADMAP:03419",
							"$ref": "#/$defs/Date"
						},
						"Published": {
							"description": "Publication date (ROADMAP:03420)",
							"$comment": "ROADMAP:03420",
							"$ref": "#/$defs/Date"
						},
						"Updated": {
							"description": "Date of last update (ROADMAP:03421)",
							"$comment": "ROADMAP:03421",
							"$ref": "#/$defs/Date"
						}
					},
					"additionalProperties": false
				},
				"Ethical review": {
					"$comment": "ROADMAP:03418",
					"type": "string",
					"minLength": 2,
					"maxLength": 512
				},
				"Funding": {
					"$comment": "ROADMAP:03385",
					"type": "string",
					"minLength": 2,
					"maxLength": 512
				},
				"License": {
					"description": "License or rights to access this resource",
					"$comment": "ROADMAP:00068",
					"type": "object",
					"minProperties": 1,
					"properties": {
						"Text": {
							"description": "Textual name or description of the license.",
							"type": "string",
							"minLength": 2,
							"maxLength": 512,
							"examples": [
								"Non-commercial use",
								"CC 4.0 BY-NC-ND"
							]
						},
						"URL": {
							"description": "URL pointing to the full text of the license.",
							"type": "string",
							"minLength": 2,
							"maxLength": 512,
							"format": "uri",
							"examples": [
								"https://creativecommons.org/licenses/by-nc-nd/4.0/"
							]
						}
					},
					"additionalProperties": false
				},
				"Organizations": {
					"description": "Sponsoring or supporting organizations",
					"$comment": "ROADMAP:00072",
					"type": "array",
					"minItems": 1,
					"items": {
						"$ref": "#/$defs/Org"
					}
				},
				"References": {
					"description": "References about the resource, such as a clinical trial identifier or a pointer to a peer-reviewed publication or conference proceedings.",
					"$comment": "ROADMAP:00067",
					"$ref": "#/$defs/Reference"
				},
				"Version": {
					"description": "Version designation of this resource",
					"$comment": "ROADMAP:00066",
					"type": "string",
					"minLength": 2,
					"maxLength": 128
				}
			},
			"additionalProperties": false
		},
		"Imaging": {
			"description": "Imaging modalities, procedures, and other information",
			"type": "object",
			"minProperties": 1,
			"properties": {
				"Modalities": {
					"description": "List of imaging modalities used to acquire the dataset's images.",
					"type": "array",
					"minItems": 1,
					"uniqueItems": true,
					"items": {
						"description": "List of imaging modalities; requires value(s) from RadLex (RID10311)",
						"$comment": "ROADMAP:00120, RadLex:RID10311",
						"type": "string",
						"enum": [
							"3-Dimensional ultrasound (RID10920)",
							"4-Dimensional CT (RID38755)",
							"4-Dimensional ultrasound (RID10926)",
							"A-mode ultrasound (RID10903)",
							"B-mode ultrasound (RID10904)",
							"Bremsstrahlung imaging (RID10336)",
							"C-mode ultrasound (RID10907)",
							"Color doppler mode (RID10909)",
							"Combined modalities (RID49580)",
							"Computed radiography (RID10349)",
							"Computed tomography (RID10321)",
							"Conventional tomography (RID10358)",
							"Diffusion tensor imaging (RID38778)",
							"Digital radiography (RID10351)",
							"Doppler mode (RID10908)",
							"Dual energy xray absorptiometry (RID10363)",
							"Dual-energy CT (RID38660)",
							"Dual-energy subtraction radiography (RID10356)",
							"Duplex ultrasound (RID10922)",
							"Dynamic contrast-enhanced magnetic resonance imaging (RID49531)",
							"Elastography (RID10932)",
							"Extended field-of-view ultrasound (RID10924)",
							"Fluoroscopy (RID10361)",
							"Functional magnetic resonance imaging (RID10317)",
							"Harmonic ultrasound (RID10913)",
							"High intensity pulse (RID10919)",
							"High-energy scan (RID12412)",
							"Low intensity pulse (RID10918)",
							"Low-energy scan (RID12411)",
							"MR fluoroscopy (RID11071)",
							"Magnetic resonance angiography (RID10319)",
							"Magnetic resonance imaging (RID10312)",
							"Magnetic resonance spectroscopy (RID10315)",
							"Mammography (RID10357)",
							"Molecular imaging (RID12508)",
							"Nuclear medicine imaging (RID10330)",
							"Other modality (dicom) (RID49585)",
							"PET-CT (RID10341)",
							"PET-MR (RID10342)",
							"Panographic radiograph (RID10360)",
							"Phase-cancellation harmonic ultrasound (RID10914)",
							"Planar nuclear medicine imaging (RID10333)",
							"Positron emission tomography (RID10337)",
							"Power doppler mode (RID10910)",
							"Projection radiography (RID10345)",
							"Quantitative computed tomography (RID10323)",
							"Radiofluoroscopy (RID45709)",
							"SPECT-CT (RID49583)",
							"Scintigraphy (RID34428)",
							"Screen-film radiography (RID10353)",
							"Single photon emission computed tomography (RID10334)",
							"Single photon imaging (RID10332)",
							"Spectral doppler mode (RID10911)",
							"Spectroscopy (RID10377)",
							"Stereoscopy (RID50131)",
							"Stereotactic radiography (RID50260)",
							"Stimulated acoustic emission (RID10916)",
							"Strain imaging (RID10933)",
							"Tomography (RID28840)",
							"Tomosynthesis (RID10359)",
							"Triplex ultrasound (RID10923)",
							"US-RF (RID49581)",
							"Ultrasound (RID10326)",
							"Volume imaging (RID10930)",
							"XR-RF (RID49582)"
						]
					}
				},
				"Procedures": {
					"description": "Imaging procedures: each item should include procedure name, RadLex Playbook ID, and/or LOINC code",
					"$comment": "Imaging procedure (ROADMAP:00121)",
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "object",
						"minProperties": 1,
						"maxProperties": 3,
						"properties": {
							"Name": {
								"description": "Procedure name",
								"type": "string",
								"minLength": 2,
								"maxLength": 256,
								"examples": [
									"CT Abdomen and Pelvis W contrast IV"
								]
							},
							"RadLex": {
								"description": "RadLex Playbook (RPID) code",
								"type": "string",
								"minLength": 5,
								"maxLength": 10,
								"pattern": "^RPID[0-9]+$",
								"examples": [
									"RPID145"
								]
							},
							"LOINC": {
								"description": "LOINC/RSNA Radiology Playbook code",
								"type": "string",
								"minLength": 1,
								"maxLength": 12,
								"examples": [
									"36813-4"
								]
							}
						},
						"additionalProperties": false,
						"examples": [
							{
								"Name": "CT Chest without IV contrast"
							},
							{
								"Name": "XR Hand - left PA",
								"LOINC": "36623-7"
							},
							{
								"Name": "CT Abdomen and Pelvis W contrast IV",
								"LOINC": "36813-4",
								"RadLex": "RPID145"
							}
						]
					}
				},
				"File format": {
					"description": "Image file format",
					"$comment": "ROADMAP:00059",
					"type": "array",
					"minItems": 1,
					"uniqueItems": true,
					"items": {
						"type": "string",
						"enum": [
							"BIDS",
							"DICOM",
							"JPEG",
							"MINC",
							"MPEG",
							"NDPI",
							"NiFTI",
							"NRRD",
							"PNG",
							"SVS",
							"WSI",
							"Other"
						]
					}
				},
				"Resolution": {
					"description": "Describes whether the dataset used original or down-sampled images.",
					"$comment": "ROADMAP:00123",
					"type": "string",
					"minLength": 2,
					"maxLength": 512
				},
				"Pre-processing": {
					"description": "Describes the type(s) of pre-processing applied to the dataset's images.",
					"$comment": "ROADMAP:00126",
					"type": "string",
					"minLength": 1,
					"maxLength": 512
				},
				"Burned-in PHI": {
					"description": "Indicates whether the images contain burned-in Protected Health Information (PHI).",
					"$comment": "ROADMAP:00129",
					"type": "string",
					"enum": [
						"Yes",
						"No",
						"Unknown"
					]
				},
				"Comments": {
					"description": "Text comments about imaging data. Use this field to specify a file format of type 'Other'",
					"$comment": "ROADMAP:00070",
					"type": "string",
					"minLength": 2,
					"maxLength": 512
				},
				"Acquisition": {
					"description": "Describes the imaging acquisition equipment and parameters used to obtain the dataset's images, such as scanner manufacturer, model, field strength, detector configuration, slice thickness, or reconstruction kernel.",
					"$comment": "ROADMAP:04128",
					"type": "object",
					"minProperties": 1,
					"properties": {
						"Manufacturer": {
							"description": "The manufacturer of the imaging equipment used to acquire the images.",
							"$comment": "ROADMAP:04129",
							"type": "string",
							"minLength": 1,
							"maxLength": 128,
							"examples": [
								"GE HealthCare",
								"Siemens Healthineers",
								"Philips",
								"Canon Medical"
							]
						},
						"Model": {
							"description": "The specific model of the imaging equipment used to acquire the images.",
							"$comment": "ROADMAP:04130",
							"type": "string",
							"minLength": 1,
							"maxLength": 128
						},
						"Field strength": {
							"description": "The static magnetic field strength of the MRI scanner used to acquire the images, typically expressed in tesla (T).",
							"$comment": "ROADMAP:04131",
							"type": "string",
							"minLength": 1,
							"maxLength": 32,
							"examples": [
								"1.5T",
								"3T"
							]
						},
						"Detector configuration": {
							"description": "The detector configuration of the imaging equipment used to acquire the images, such as the number of detector rows for CT.",
							"$comment": "ROADMAP:04132",
							"type": "string",
							"minLength": 1,
							"maxLength": 64
						},
						"Slice thickness": {
							"description": "The thickness of the reconstructed image slices.",
							"$comment": "ROADMAP:04133",
							"type": "string",
							"minLength": 1,
							"maxLength": 32,
							"examples": [
								"0.25 cm"
							]
						},
						"Reconstruction kernel": {
							"description": "The reconstruction kernel or algorithm applied to raw acquisition data to produce the reconstructed images.",
							"$comment": "ROADMAP:04134",
							"type": "string",
							"minLength": 1,
							"maxLength": 128
						}
					},
					"additionalProperties": false
				}
			},
			"additionalProperties": false
		},
		"Indexing": {
			"description": "Indexing codes: Content codes, RadLex, SNOMED, and keywords",
			"$comment": "ROADMAP:00074",
			"type": "object",
			"minProperties": 1,
			"properties": {
				"Content": {
					"description": "RSNA 2-letter content codes, e.g., CT",
					"$comment": "ROADMAP:00073",
					"type": "array",
					"minItems": 1,
					"uniqueItems": true,
					"items": {
						"type": "string",
						"enum": [
							"BR",
							"BQ",
							"CA",
							"CH",
							"CT",
							"ED",
							"ER",
							"GI",
							"GU",
							"HN",
							"HP",
							"IN",
							"IR",
							"LM",
							"MI",
							"MK",
							"MR",
							"NM",
							"NR",
							"OB",
							"OI",
							"OT",
							"PD",
							"PH",
							"PR",
							"SQ",
							"RO",
							"RS",
							"US",
							"VA"
						],
						"examples": [
							"CT",
							"GI"
						]
					}
				},
				"RadLex": {
					"description": "Array of RadLex codes (e.g., RID58)",
					"$comment": "ROADMAP:00117",
					"type": "array",
					"minItems": 1,
					"uniqueItems": true,
					"items": {
						"$comment": "https://radlex.org/RID/$",
						"type": "string",
						"minLength": 4,
						"maxLength": 12,
						"pattern": "^RID[0-9]+$",
						"examples": [
							"RID58",
							"RID1169"
						]
					}
				},
				"SNOMED": {
					"description": "Array of SNOMED CT concept identifiers (SCTIDs). Integer values are allowed up to 11 digits, which addresses concepts from the International Release. National or local extensions require string values to avoid possibly imprecise interpretation of large integer values. IMPORTANT: The string values are the canonical format; the integer format will be dropped in the next version.",
					"$comment": "ROADMAP:03625, https://lookup.snomedtools.org/$",
					"type": "array",
					"minItems": 1,
					"uniqueItems": true,
					"items": {
						"examples": [
							10200004,
							"441802002",
							"999000011000000103"
						],
						"anyOf": [
							{
								"type": "string",
								"pattern": "^[1-9][0-9]{5,17}$",
								"minLength": 6
							},
							{
								"type": "integer",
								"minimum": 100000,
								"maximum": 99999999999
							}
						]
					}
				},
				"Keywords": {
					"description": "Array of keywords to index the resource",
					"$comment": "ROADMAP:03721",
					"type": "array",
					"minItems": 1,
					"uniqueItems": true,
					"items": {
						"type": "string",
						"minLength": 2,
						"maxLength": 64
					}
				}
			},
			"additionalProperties": false
		},
		"Org": {
			"title": "Organization description",
			"description": "Details for each organization",
			"$comment": "ROADMAP:00072",
			"type": "object",
			"minProperties": 1,
			"properties": {
				"Name": {
					"description": "Name of organization",
					"type": "string",
					"minLength": 2,
